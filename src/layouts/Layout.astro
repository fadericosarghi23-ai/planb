---
import '../styles/tokens.css';
import '../styles/testi.css';
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import media from '../data/media.json';
import { site } from '../data/site';

interface Props { seo: { title: string; description: string; ogImage?: string | null }; chrome?: boolean; noindex?: boolean; bg?: string }
const { seo, chrome = true, noindex = false, bg } = Astro.props;
const M = media as Record<string, { src: string; w: number; h: number }>;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(Astro.url.pathname, site.dominio).href;
const og = seo.ogImage ? M[seo.ogImage] : M['og-01'];
const ogUrl = og ? new URL(og.src, site.dominio).href : undefined;
const schema = {
  '@context': 'https://schema.org/', '@type': 'LocalBusiness', name: site.ragioneSociale, url: site.dominio,
  image: new URL(site.immagineSchema, site.dominio).href, telephone: site.telefono,
  address: { '@type': 'PostalAddress', addressCountry: site.indirizzo.paese, addressLocality: site.indirizzo.citta, postalCode: site.indirizzo.cap, streetAddress: site.indirizzo.via },
};
---
<!doctype html>
<html lang={site.lingua}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.nome} />
    <meta property="og:type" content="website" />
    {ogUrl && <meta property="og:image" content={ogUrl} />}
    {og && <meta property="og:image:width" content={String(og.w)} />}
    {og && <meta property="og:image:height" content={String(og.h)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body class="sito" style={bg ? `background:${bg}` : undefined}>
    {chrome && <Header path={path} />}
    <slot />
    {chrome && <Footer />}
    {site.whatsapp && (
      <a class="whatsapp" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener" aria-label="Scrivici su WhatsApp">
        <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.64.08-.3-.15-1.26-.46-2.39-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.07c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.7.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2-1.42.25-.69.25-1.29.18-1.41-.08-.13-.28-.2-.57-.35m-5.42 7.4h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.88 9.89-9.88 2.64 0 5.12 1.03 6.99 2.9a9.83 9.83 0 0 1 2.89 6.99c0 5.45-4.44 9.88-9.88 9.88m8.41-18.3A11.82 11.82 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.89c0 2.1.55 4.14 1.59 5.95L.06 24l6.3-1.65a11.88 11.88 0 0 0 5.68 1.45h.01c6.55 0 11.89-5.34 11.89-11.89a11.82 11.82 0 0 0-3.48-8.41Z" /></svg>
      </a>
    )}
    <div class="lightbox" role="dialog" aria-modal="true" aria-label="Immagine ingrandita">
      <div class="lb-media"><img alt="" /></div>
      <div class="lb-info"><h2 class="lb-title"></h2><p class="lb-desc"></p><a class="lb-link" href="#"></a></div>
      <button class="lb-close" type="button" aria-label="Chiudi"><svg viewBox="0 0 24 24" width="30" height="30" aria-hidden="true"><path d="M4 4l16 16M20 4 4 20" stroke="currentColor" stroke-width="1.5" /></svg></button>
      <button class="lb-prev" type="button" aria-label="Precedente"><svg viewBox="0 0 23 39" width="23" height="39" aria-hidden="true"><path d="M21 2 3 19.5 21 37" fill="none" stroke="currentColor" stroke-width="2" /></svg></button>
      <button class="lb-next" type="button" aria-label="Successiva"><svg viewBox="0 0 23 39" width="23" height="39" aria-hidden="true"><path d="m2 2 18 17.5L2 37" fill="none" stroke="currentColor" stroke-width="2" /></svg></button>
    </div>
    <script src="../scripts/sito.js"></script>
  </body>
</html>
