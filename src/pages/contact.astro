---
// Contatti: una sola schermata sulla foto dell'ingresso dello studio. Modulo e recapiti stanno
// insieme sulla sinistra, così a destra resta visibile il cartello dello studio nella foto.
// Recapiti da data/pagine/contact.json, impostazione e testi del modulo da data/contatti.json.
import Layout from '../layouts/Layout.astro';
import Nodo from '../components/Nodo.astro';
import p from '../data/pagine/contact.json';
import c from '../data/contatti.json';
import media from '../data/media.json';
import { site } from '../data/site';

const M = media as Record<string, { src: string; w: number; h: number; alt: string }>;
const trova = (id: string, nodi: any[] = p.sections as any[]): any => {
  for (const n of nodi) { if (n.id === id) return n; const r = trova(id, n.c || []); if (r) return r; }
  return null;
};
const nodo = (id: string) => ({ ...trova(id), fx: undefined });
const foto = M[c.foto];
---
<Layout seo={p.seo} chrome={p.chrome} bg="var(--nero)">
  <section class="c-pagina">
    <img class="c-foto" src={foto.src} width={foto.w} height={foto.h} alt={foto.alt || ''} fetchpriority="high"
      style={`object-position:${c.fuoco[0]}% ${c.fuoco[1]}%`} />
    <div class="c-velo" aria-hidden="true"></div>

    <div class="c-cornice">
      <form class="c-modulo" action={site.form.endpoint || undefined} method={site.form.metodo} data-endpoint={site.form.endpoint}>
        <p class="c-nome">{c.nome}</p>
        <h1>{c.modulo.titolo}</h1>
        <p class="c-intro">{c.modulo.testo}</p>
        {c.modulo.campi.map((f) => (
          <label class="c-campo">
            <span>{f.etichetta}</span>
            {f.tipo === 'textarea' ? <textarea name={f.nome} rows="4" required></textarea> : <input type={f.tipo} name={f.nome} required={f.nome !== 'telefono'} />}
          </label>
        ))}
        <label class="c-privacy"><input type="checkbox" required /><span>{c.modulo.privacy}</span></label>
        <button type="submit" class="c-invia">{c.modulo.invio}</button>
      </form>

      <aside class="c-lato">
        {c.colonne.map((col) => (
          <div class="c-col">
            <Nodo n={nodo(col.titolo)} />
            {col.voci.map((v) => <Nodo n={nodo(v)} />)}
          </div>
        ))}
      </aside>
    </div>
  </section>
</Layout>

<style>
  .c-pagina { position: relative; min-height: 100vh; min-height: 100dvh; margin-top: calc(var(--header-h) * -1); padding: calc(var(--header-h) + 48px) 40px 64px; display: flex; align-items: center; overflow: hidden; color: var(--chiaro); }
  .c-foto { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .c-velo { position: absolute; inset: 0; background: linear-gradient(to right, rgba(0, 0, 0, .6), rgba(0, 0, 0, .35) 45%, rgba(0, 0, 0, .05) 70%); } /* scuro a sinistra sotto i testi, chiaro sul cartello */

  .c-cornice { position: relative; margin-left: max(0px, calc(6vw - 40px)); display: grid; grid-template-columns: minmax(0, 470px) auto; gap: 52px; align-items: center; }
  .c-lato { display: flex; flex-direction: column; gap: 36px; text-align: left; }
  .c-col { display: flex; flex-direction: column; gap: 6px; }
  .c-col :global(.wx) { position: relative; left: auto; top: auto; width: auto; height: auto; }
  .c-col :global(.wx-text) { pointer-events: auto; }
  .c-col :global(.wx-text *) { color: var(--chiaro) !important; text-align: inherit !important; }
  .c-col > :global(.wx:first-child) { margin-bottom: 8px; opacity: .7; }
  .c-col :global(a) { transition: opacity .3s; }
  .c-col :global(a:hover) { opacity: .65; }

  .c-modulo { display: flex; flex-direction: column; gap: 16px; padding: 44px 44px 40px;
    background: rgba(20, 20, 20, .42); border: 1px solid rgba(255, 255, 255, .18); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); }
  .c-nome { font: 300 13px/1 var(--font-avenir); letter-spacing: .25em; text-transform: uppercase; opacity: .75; }
  .c-modulo h1 { font: 800 40px/1.1 var(--font-avenir); letter-spacing: -1px; }
  .c-intro { font: 300 15px/1.6 var(--font-avenir); opacity: .85; margin-bottom: 6px; }
  .c-campo { display: flex; flex-direction: column; gap: 8px; font: 300 12px/1 var(--font-avenir); letter-spacing: .14em; text-transform: uppercase; }
  .c-campo input, .c-campo textarea { background: transparent; border: 0; border-bottom: 1px solid rgba(255, 255, 255, .45); color: var(--chiaro); font: 300 17px/1.5 var(--font-avenir); padding: 6px 0 10px; outline: none; transition: border-color .3s; resize: vertical; }
  .c-campo input:focus, .c-campo textarea:focus { border-bottom-color: var(--chiaro); }
  .c-privacy { display: flex; gap: 12px; align-items: flex-start; font: 300 13px/1.5 var(--font-avenir); opacity: .85; }
  .c-privacy input { margin-top: 3px; accent-color: var(--chiaro); }
  .c-invia { align-self: flex-start; margin-top: 8px; padding: 0 46px; height: 50px; border: 1px solid var(--chiaro); background: transparent; color: var(--chiaro); font: 300 15px var(--font-avenir); letter-spacing: .2em; cursor: pointer; transition: background-color .3s, color .3s; }
  .c-invia:hover { background: var(--chiaro); color: var(--scuro); }

  @media (max-width: 750px) {
    .c-pagina { margin-top: calc(var(--header-h-m) * -1); padding: calc(var(--header-h-m) + 8vw) 6.25vw 12vw; }
    .c-cornice { margin-left: 0; grid-template-columns: 1fr; gap: 9vw; }
    .c-velo { background: linear-gradient(to bottom, rgba(0, 0, 0, .55), rgba(0, 0, 0, .7)); }
    .c-modulo { padding: 8vw 6vw; }
    .c-modulo h1 { font-size: 10vw; }
    .c-lato { gap: 7vw; }
  }
</style>
