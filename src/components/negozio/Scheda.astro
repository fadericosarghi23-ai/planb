---
// Scheda prodotto: galleria con miniature, titolo, prezzi, quantità, carrello/acquista (non collegati), sezioni a scomparsa.
import media from '../../data/media.json';
interface Props { s: any }
const { s } = Astro.props;
const M = media as Record<string, { src: string; w: number; h: number; alt: string }>;
const imgs = s.images.map((id: string) => M[id]).filter(Boolean);
const c = s.cls;
---
<div class="scheda" style={`--cart-bg:${s.cartBg};--buy-bg:${s.buyBg};--line:${s.line}`}>
  <nav class="nav" aria-label="Percorso">
    <a href="/" class={c.desc}>Home</a><span aria-hidden="true">/</span><a href="/category/all-products" class={c.desc}>All Products</a><span aria-hidden="true">/</span><span class={c.desc}>{s.title}</span>
  </nav>
  <div class="galleria" data-scheda-gal>
    <div class="principale">
      {imgs.map((im: any, i: number) => <img src={im.src} width={im.w} height={im.h} alt={im.alt} class={i === 0 ? 'on' : ''} loading={i === 0 ? 'eager' : 'lazy'} />)}
    </div>
    <div class="miniature">
      {imgs.map((im: any, i: number) => <button type="button" data-i={i} class={i === 0 ? 'on' : ''} aria-label={`Immagine ${i + 1}`}><img src={im.src} width={im.w} height={im.h} alt="" loading="lazy" /></button>)}
    </div>
  </div>
  <div class="descr"><p class={c.desc}>{s.desc}</p></div>
  <div class="info">
    <h1 class={c.title}>{s.title}</h1>
    <p class="prezzi">{s.before && <span class={c.before}>{s.before}</span>}<span class={c.price}>{s.price}</span></p>
    <div class="qta">
      <span class={c.qty}>{s.qty} *</span>
      <div class="contatore"><button type="button" data-qta="-1" aria-label="Diminuisci">−</button><input type="number" value="1" min="1" aria-label={s.qty} /><button type="button" data-qta="1" aria-label="Aumenta">+</button></div>
    </div>
    <button type="button" class="btn carrello"><span class={c.cart}>{s.addToCart}</span></button>
    <button type="button" class="btn compra"><span class={c.buy}>{s.buyNow}</span></button>
    <div class="sezioni">
      {s.info.map((it: any, i: number) => (
        <details open={i === 0}>
          <summary><span class={c.infoTitle}>{it.title}</span><span class="piu" aria-hidden="true"></span></summary>
          <div class={`corpo ${c.infoBody}`} set:html={it.html} />
        </details>
      ))}
    </div>
  </div>
</div>
<style>
  .scheda { position: relative; height: 100%; }
  .nav { position: absolute; left: 45px; top: 60px; display: flex; gap: 8px; align-items: center; color: var(--scuro); }
  .galleria { position: absolute; left: 45px; top: 140px; width: 500px; }
  .principale { position: relative; width: 500px; height: 500px; }
  .principale img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity .3s; }
  .principale img.on { opacity: 1; }
  .miniature { display: flex; gap: 6px; margin-top: 14px; }
  .miniature button { width: 45px; height: 45px; padding: 0; border: 1px solid transparent; background: none; cursor: pointer; }
  .miniature button.on { border-color: var(--scuro); }
  .miniature img { width: 100%; height: 100%; object-fit: cover; }
  .descr { position: absolute; left: 45px; top: 719px; width: 500px; }
  .info { position: absolute; left: 580px; top: 140px; width: 355px; }
  .prezzi { display: flex; gap: 6px; margin-top: 22px; }
  .qta { margin-top: 20px; display: flex; flex-direction: column; gap: 4px; }
  .contatore { display: flex; width: 92px; height: 35px; border: 1px solid var(--line); }
  .contatore button { width: 28px; background: none; border: 0; cursor: pointer; color: var(--scuro); font-size: 18px; }
  .contatore input { width: 36px; border: 0; text-align: center; background: none; color: var(--scuro); -moz-appearance: textfield; }
  .contatore input::-webkit-inner-spin-button { -webkit-appearance: none; }
  .btn { display: flex; align-items: center; justify-content: center; width: 355px; height: 40px; border: 0; cursor: pointer; transition: opacity .2s; }
  .btn:hover { opacity: .85; }
  .carrello { margin-top: 32px; background: var(--cart-bg); }
  .compra { margin-top: 12px; background: var(--buy-bg); }
  .sezioni { margin-top: 24px; }
  details { border-bottom: 1px solid var(--line); padding: 16px 0; }
  summary { display: flex; justify-content: space-between; align-items: center; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  .piu { position: relative; width: 15px; height: 15px; }
  .piu::before, .piu::after { content: ''; position: absolute; left: 0; top: 7px; width: 15px; height: 1px; background: var(--scuro); transition: transform .2s; }
  .piu::after { transform: rotate(90deg); }
  details[open] .piu::after { transform: rotate(0); }
  .corpo { margin-top: 16px; }
  @media (max-width: 750px) {
    .nav { left: 6.25vw; top: 6.25vw; }
    .nav > :not(:first-child) { display: none; }
    .galleria { left: 12.5vw; top: 21.25vw; width: 75vw; }
    .principale { width: 75vw; height: 75vw; }
    .miniature { justify-content: center; margin-top: 2vw; }
    .miniature button { width: 6.25vw; height: 6.25vw; border-radius: 50%; overflow: hidden; }
    .info { left: 12.5vw; top: 115vw; width: 75vw; }
    .btn { width: 75vw; height: 12.5vw; }
    .carrello { margin-top: 7.5vw; }
    .compra { margin-top: 3.75vw; }
    .descr { left: 12.5vw; top: 210vw; width: 75vw; }
    .sezioni { position: relative; top: 47vw; }
  }
</style>
