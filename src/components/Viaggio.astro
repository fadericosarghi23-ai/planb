---
// Home come viaggio continuo nel modello 3D della villa (scripts/villa3d.js): vista dall'alto identica
// alla foto aerea, giro attorno alla casa (tappa Architettura), poi in volo dentro ogni stanza dalla sua
// vetrata. Le stanze sono volumi su cui è proiettato un render dello studio (data/viaggio.json → stanze3d):
// arrivati nel punto di ripresa la stanza è identica alla foto. Ogni tappa mostra una sezione della landing
// (testi da data/pagine/home.json). Senza WebGL resta la foto aerea.
import Nodo from './Nodo.astro';
import home from '../data/pagine/home.json';
import viaggio from '../data/viaggio.json';
import media from '../data/media.json';

const M = media as Record<string, { src: string; w: number; h: number; alt: string }>;
const trova = (id: string, nodi: any[] = home.sections as any[]): any => {
  for (const n of nodi) { if (n.id === id) return n; const r = trova(id, n.c || []); if (r) return r; }
  return null;
};
const stanze = viaggio.stanze.map((s) => ({ ...s, nodi: s.testi.map((id: string) => trova(id)).filter(Boolean).map((n: any) => ({ ...n, fx: undefined })) }));
const fotogrammi = (viaggio.fotogrammi as any[]).map((f) => ({ ...f, m: f.img ? M[f.img] : null, lung: f.lung ?? (f.stanza !== undefined ? 0.7 : 0.35) }));
const corsa = fotogrammi.reduce((a, f) => a + f.lung, 0);
const aerea = M[viaggio.fotoAerea];
const dati = fotogrammi.map((f) => ({ tipo: f.tipo || 'img', lung: f.lung, sosta: f.sosta ?? 0, tappa: f.tappa ?? 0, stanza: f.stanza ?? -1 }));
const stanze3d = (viaggio as any).stanze3d.map((s: any) => ({ ...s, src: M[s.img].src, w: M[s.img].w, h: M[s.img].h }));
const path = '/';
---
<div class="viaggio" style={`--corsa:${corsa}`} data-fotogrammi={JSON.stringify(dati)} data-stanze3d={JSON.stringify(stanze3d)}>
  <div class="v-palco">
    <div class="v-f v-3d" data-k="3d">
      <canvas class="v-canvas" aria-hidden="true"></canvas>
      <img class="v-aerea" src={aerea.src} width={aerea.w} height={aerea.h} alt={aerea.alt || ''} fetchpriority="high" />
      <p class="v-carico" aria-hidden="true"><span></span></p>
    </div>
    {fotogrammi.map((f, i) => f.m && (
      <img class="v-f" data-i={i} src={f.m.src} width={f.m.w} height={f.m.h} alt={f.m.alt || ''} decoding="async"
        style={`object-position:${f.fuoco[0]}% ${f.fuoco[1]}%;transform-origin:${f.fuoco[0]}% ${f.fuoco[1]}%;opacity:0`} data-fx={f.fuoco[0]} data-fy={f.fuoco[1]} />
    ))}
    <div class="v-velo" aria-hidden="true"></div>
    {stanze.map((s, i) => (
      <section class={`v-pannello ${i === 0 ? 'attivo' : ''} ${s.nodi.length ? '' : 'solo-nome'}`} data-i={i} aria-label={s.nome}>
        <p class="v-nome"><span>{String(i + 1).padStart(2, '0')}</span>{s.nome}</p>
        {s.nodi.map((n: any) => <Nodo n={n} path={path} />)}
        {i === 0 && <p class="v-invito">{viaggio.invito}<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M5 9l7 7 7-7" fill="none" stroke="currentColor" stroke-width="1.5" /></svg></p>}
      </section>
    ))}
    <nav class="v-indice" aria-label="Stanze della casa">
      {stanze.map((s, i) => <button type="button" data-vai={i} class={i === 0 ? 'attivo' : ''} aria-label={s.nome}><span>{s.nome}</span></button>)}
    </nav>
  </div>
</div>

<style>
  .viaggio { position: relative; height: calc((var(--corsa) + 1) * 100vh); margin-top: calc(var(--header-h) * -1); }
  .v-palco { position: sticky; top: 0; height: 100vh; overflow: hidden; background: var(--nero); }
  .v-f { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; will-change: transform, opacity, filter; backface-visibility: hidden; }
  .v-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .v-aerea { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: opacity .6s linear; }
  .pronta .v-aerea { opacity: 0; }
  .v-carico { position: absolute; left: 50%; top: 50%; width: 120px; height: 2px; margin-left: -60px; background: rgba(255, 255, 255, .25); overflow: hidden; transition: opacity .4s; }
  .v-carico span { display: block; width: 40%; height: 100%; background: var(--chiaro); animation: v-carico 1.2s ease-in-out infinite; }
  @keyframes v-carico { from { transform: translateX(-100%); } to { transform: translateX(250%); } }
  .pronta .v-carico, .senza-3d .v-carico { opacity: 0; }
  .v-velo { position: absolute; inset: 0; pointer-events: none; background: linear-gradient(to top, rgba(0, 0, 0, .62), rgba(0, 0, 0, .12) 50%, rgba(0, 0, 0, 0) 70%), linear-gradient(to bottom, rgba(0, 0, 0, .25), rgba(0, 0, 0, 0) 20%); }
  .v-pannello { position: absolute; left: 50%; bottom: 7vh; width: min(980px, calc(100% - 140px)); transform: translate(-50%, 24px); opacity: 0; visibility: hidden; transition: opacity .7s var(--ease-wix), transform .9s var(--ease-wix), visibility 0s .7s; text-align: center; }
  .v-pannello.attivo { opacity: 1; visibility: visible; transform: translate(-50%, 0); transition: opacity .7s var(--ease-wix), transform .9s var(--ease-wix), visibility 0s; }
  .v-pannello :global(.wx) { position: relative; left: auto; top: auto; width: auto; height: auto; margin: 0 auto 14px; max-width: 864px; }
  .v-pannello :global(.wx-btn) { width: var(--dw); height: var(--dh); margin-top: 22px; }
  .v-pannello :global(.wx-text) { pointer-events: auto; text-shadow: 0 1px 18px rgba(0, 0, 0, .35); }
  .v-pannello :global(.wx-text *) { background-color: transparent !important; }
  .v-nome { display: inline-flex; gap: 12px; align-items: baseline; margin-bottom: 18px; font: 300 13px/1 var(--font-avenir); letter-spacing: .25em; text-transform: uppercase; color: var(--chiaro); }
  .v-nome span { font-weight: 800; }
  .solo-nome .v-nome { font-size: 15px; }
  .v-invito { display: flex; flex-direction: column; align-items: center; gap: 8px; font: 300 16px/1.4 var(--font-avenir); letter-spacing: .08em; color: var(--chiaro); }
  .v-invito svg { animation: v-giu 1.6s ease-in-out infinite; }
  @keyframes v-giu { 50% { transform: translateY(6px); } }
  .v-indice { position: absolute; right: 26px; top: 50%; transform: translateY(-50%); display: flex; flex-direction: column; gap: 14px; }
  .v-indice button { position: relative; width: 10px; height: 10px; padding: 0; border-radius: 50%; border: 1px solid var(--chiaro); background: transparent; cursor: pointer; transition: background-color .3s, transform .3s; }
  .v-indice button.attivo { background: var(--chiaro); transform: scale(1.25); }
  .v-indice span { position: absolute; right: 22px; top: 50%; transform: translateY(-50%); white-space: nowrap; font: 300 12px var(--font-avenir); letter-spacing: .1em; color: var(--chiaro); opacity: 0; transition: opacity .3s; pointer-events: none; }
  .v-indice button:hover span, .v-indice button.attivo span { opacity: 1; }
  @media (max-width: 750px) {
    .viaggio { margin-top: calc(var(--header-h-m) * -1); }
    .v-pannello { width: calc(100% - 12.5vw); bottom: 5vh; }
    .v-pannello :global(.wx) { max-width: none; }
    .v-pannello :global(.wx-btn) { width: var(--mw); height: var(--mh); }
    .v-nome { font-size: 3.4vw; margin-bottom: 3vw; }
    .v-indice { right: 3vw; gap: 3vw; }
    .v-indice span { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .v-pannello, .v-pannello.attivo { transition: none; } .v-invito svg { animation: none; } }
</style>

<script>
  import { avviaVilla } from '../scripts/villa3d.js';

  // Scroll → posizione nel viaggio. Nei fotogrammi 3D lo scroll muove la camera nel modello;
  // nei render la camera avanza verso il punto d'ingresso, poi sfuma nel fotogramma successivo.
  const root = document.querySelector('.viaggio') as HTMLElement;
  if (root) {
    type F = { tipo: string; lung: number; sosta: number; tappa: number; stanza: number };
    const F: F[] = JSON.parse(root.dataset.fotogrammi!);
    const strato3d = root.querySelector('.v-3d') as HTMLElement;
    const imgs = new Map([...root.querySelectorAll<HTMLImageElement>('img.v-f')].map((el) => [+el.dataset.i!, el]));
    const strato = (k: number): HTMLElement => (F[k].tipo === '3d' ? strato3d : imgs.get(k)!);
    const pannelli = [...root.querySelectorAll<HTMLElement>('.v-pannello')];
    const punti = [...root.querySelectorAll<HTMLButtonElement>('.v-indice button')];
    const ridotto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const inizi = F.map((_, i) => F.slice(0, i).reduce((a, f) => a + f.lung, 0));
    const corsa = F.reduce((a, f) => a + f.lung, 0);
    const io = (x: number) => (x < 0.5 ? 2 * x * x : 1 - Math.pow(-2 * x + 2, 2) / 2);
    const clamp = (x: number) => Math.max(0, Math.min(1, x));
    const PASSO = 0.78; // da qui in poi il fotogramma "attraversa" nel successivo

    // modello 3D (se il browser non lo supporta resta la foto aerea)
    let villa: any = null; let tappe: number[] = [0, 0.5, 1];
    const webgl = (() => { try { const c = document.createElement('canvas'); return !!(c.getContext('webgl2') || c.getContext('webgl')); } catch { return false; } })();
    if (webgl) {
      villa = avviaVilla({ canvas: root.querySelector('.v-canvas') as HTMLCanvasElement, stanze: JSON.parse(root.dataset.stanze3d!), fotoSrc: (root.querySelector('.v-aerea') as HTMLImageElement).src, onPronto: () => root.classList.add('pronta') });
      tappe = villa.tappe;
    } else root.classList.add('senza-3d');

    const posaImg = (el: HTMLElement, p: number, visibile: number, scalaIn = 1) => {
      const avvicina = ridotto ? 0 : 0.16 * io(clamp(p / PASSO));
      const tuffo = ridotto ? 0 : 1.1 * Math.pow(clamp((p - PASSO) / (1 - PASSO)), 2);
      const s = (1 + avvicina + tuffo) * scalaIn;
      const fx = +(el.dataset.fx || 50), fy = +(el.dataset.fy || 50);
      const t = (s - 1) / s; // il punto d'ingresso scivola verso il centro mentre si avanza
      const uscita = clamp((p - PASSO - 0.04) / (1 - PASSO - 0.04));
      el.style.opacity = String(Math.min(visibile, 1 - io(uscita)));
      el.style.transform = `translate3d(${((50 - fx) * t * 0.55).toFixed(3)}%, ${((50 - fy) * t * 0.55).toFixed(3)}%, 0) scale(${s.toFixed(4)})`;
      el.style.filter = !ridotto && uscita > 0 ? `blur(${(uscita * 6).toFixed(2)}px)` : 'none';
    };
    const posa3d = (k: number, p: number) => {
      const f = F[k], da = tappe[f.tappa], a = tappe[f.tappa + 1] ?? 1;
      villa?.vai(da + (a - da) * io(clamp((p - f.sosta) / (1 - f.sosta))));
      const ultimo = !!F[k + 1] && F[k + 1].tipo !== '3d';
      const uscita = ultimo ? clamp((p - 0.86) / 0.14) : 0;
      strato3d.style.opacity = String(1 - io(uscita));
      strato3d.style.filter = !ridotto && uscita > 0 ? `blur(${(uscita * 5).toFixed(2)}px)` : 'none';
    };

    let att = 0, obiettivo = 0, ultimaStanza = 0, attiva = 0;
    const inizio = () => root.getBoundingClientRect().top + window.scrollY;
    const leggi = () => { obiettivo = Math.max(0, Math.min(corsa - 0.0001, (window.scrollY - inizio()) / window.innerHeight)); };
    const disegna = () => {
      let i = 0; for (let k = 0; k < inizi.length; k++) if (inizi[k] <= att) i = k;
      const p = clamp((att - inizi[i]) / F[i].lung);
      const visibili = new Set<HTMLElement>();
      if (F[i].tipo === '3d') { posa3d(i, p); visibili.add(strato3d); }
      else { posaImg(strato(i), p, 1); visibili.add(strato(i)); }
      const sogliaUscita = F[i].tipo === '3d' ? 0.86 : PASSO;
      if (F[i + 1] && F[i + 1].tipo !== '3d' && p > sogliaUscita && strato(i + 1) !== strato(i)) {
        const e = io(clamp((p - sogliaUscita) / (1 - sogliaUscita))); posaImg(strato(i + 1), 0, e, 1.05 - 0.05 * e); visibili.add(strato(i + 1));
      }
      for (const el of [strato3d, ...imgs.values()]) if (!visibili.has(el) && el.style.opacity !== '0') el.style.opacity = '0';
      const s = F[i].stanza;
      const lettura = F[i].tipo === '3d' ? F[i].sosta + 0.12 : 0.7;
      const nuova = s >= 0 && p < lettura ? s : -1;
      if (s >= 0) ultimaStanza = s;
      if (nuova !== attiva) { attiva = nuova; pannelli.forEach((el, k) => el.classList.toggle('attivo', k === attiva)); }
      punti.forEach((b, k) => b.classList.toggle('attivo', k === ultimaStanza));
    };
    const ciclo = () => {
      const d = obiettivo - att;
      if (Math.abs(d) > 0.0005) { att += d * (ridotto ? 1 : 0.12); disegna(); }
      requestAnimationFrame(ciclo);
    };
    window.addEventListener('scroll', leggi, { passive: true });
    window.addEventListener('resize', () => { leggi(); disegna(); });
    leggi(); att = obiettivo; disegna(); requestAnimationFrame(ciclo);
    punti.forEach((b, k) => b.addEventListener('click', () => {
      const f = F.findIndex((x) => x.stanza === k);
      window.scrollTo({ top: inizio() + (inizi[f] + F[f].lung * 0.15) * window.innerHeight, behavior: 'smooth' });
    }));
  }
</script>
