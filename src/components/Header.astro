---
// Header fisso: desktop dall'albero di chrome.json (logo, lingue, menu, accesso, carrello); mobile con hamburger.
import chrome from '../data/chrome.json';
import Nodo from './Nodo.astro';
interface Props { path: string }
const { path } = Astro.props;
const h = chrome.header as any;
const menu = (() => { const f = (n: any): any => (n.k === 'menu' ? n : (n.c || []).map(f).find(Boolean)); return f(h); })();
const lingue = (() => { const f = (n: any): any => (n.k === 'lang' ? n : (n.c || []).map(f).find(Boolean)); return f(h); })();
---
<header class="sito-header" style={`--header-bg-m:${chrome.headerBgM}`}>
  <div class="header-in">
    {h.c.map((c: any) => <Nodo n={c} path={path} />)}
  </div>
  <button class="hamb" type="button" aria-label="Apri menu di navigazione" aria-expanded="false" aria-controls="menu-mobile"><span></span><span></span><span></span></button>
  <div class="menu-mobile" id="menu-mobile">
    <div class="mm-bg"></div>
    <div class="mm-lingue">{lingue && lingue.langs.map((l: any, i: number) => <span class={l.cls} style="margin-right:2.5vw">{l.label}</span>)}</div>
    <ul class="mm-lista">
      {menu.items.map((it: any) => (
        <li>
          {it.sub.length ? (
            <>
              <button type="button" data-sub aria-expanded="false">{it.label}<svg viewBox="0 0 9.28 4.9" width="12" height="6" aria-hidden="true"><path d="M4.64 4.9a.5.5 0 0 1-.34-.14L.16.86A.5.5 0 0 1 .84.14l3.8 3.57L8.44.14a.5.5 0 0 1 .69.73L4.98 4.76a.5.5 0 0 1-.34.14Z" /></svg></button>
              <ul class="mm-sub"><li><a href={it.href}>{it.label}</a></li>{it.sub.map((s: any) => <li><a href={s.href}>{s.label}</a></li>)}</ul>
            </>
          ) : (
            <a href={it.href}>{it.label}</a>
          )}
        </li>
      ))}
    </ul>
  </div>
</header>
<style>
  /* header pieno anche su mobile (stesso grigio scuro del desktop, da styles/base.css) */
</style>
