---
// Pagine galleria (Interni, Architettura, Prodotti): testata con titolo e testo nel colore della pagina, poi una
// griglia ordinata di foto con didascalia (nome / luogo). Clic → lightbox del sito (scripts/sito.js).
// Testi, colori e foto vengono da data/pagine/<pagina>.json: si usano il primo testo (titolo), il secondo
// (introduzione) e la galleria; l'impaginazione a posizioni fisse del sito di partenza non si usa più.
// formato "progetti": 2 colonne, foto stessa proporzione; "prodotti": 3 colonne, foto intera su fondo chiaro.
import Layout from '../layouts/Layout.astro';
import media from '../data/media.json';

interface Props { p: any; formato?: 'progetti' | 'prodotti' }
const { p, formato = 'progetti' } = Astro.props;
const M = media as Record<string, { src: string; w: number; h: number; alt: string }>;

// nodi con il colore di fondo del contenitore più vicino
const nodi: { n: any; bg: string | null }[] = [];
const visita = (ns: any[], bg: string | null) => { for (const n of ns) { const b = n.bg?.color || n.boxBg || bg; nodi.push({ n, bg: b }); visita(n.c || [], b); } };
visita(p.sections, null);
const testi = nodi.filter((x) => x.n.k === 'text');
const gal = nodi.find((x) => x.n.k === 'gallery')!;

const ENT: Record<string, string> = { nbsp: ' ', amp: '&', quot: '"', apos: "'", lt: '<', gt: '>', rsquo: '’', lsquo: '‘', egrave: 'è', eacute: 'é', agrave: 'à', ograve: 'ò', ugrave: 'ù', igrave: 'ì' };
const testo = (h: string) => h.replace(/<br\s*\/?>/gi, '\n').replace(/<[^>]+>/g, '')
  .replace(/&(#\d+|[a-z]+);/gi, (m, e) => (e[0] === '#' ? String.fromCharCode(+e.slice(1)) : ENT[e.toLowerCase()] ?? m)).replace(/[ \t]+/g, ' ').trim();
const paragrafi = (h: string) => (h || '').split(/<\/p>/i).map(testo).filter(Boolean);

const titolo = paragrafi(testi[0]?.n.html).join(' ');
const intro = paragrafi(testi[1]?.n.html);
const colore = testi[0]?.bg || 'var(--grigio-scuro)';
const sfondoGal = gal.bg; // null = fondo pagina (chiaro)

const voci = gal.n.items.map((it: any) => {
  const [nome, ...luogo] = (it.title || '').split(' / ');
  return { ...it, m: M[it.img], nome, luogo: luogo.join(' / ') };
});
const lb = JSON.stringify(voci.map((i: any) => ({ src: i.m?.src, w: i.m?.w, h: i.m?.h, alt: i.m?.alt, title: i.title, desc: i.desc, link: i.linkText ? { text: i.linkText, href: i.linkTo } : null })));
---
<Layout seo={p.seo} chrome={p.chrome} bg={p.bodyBg}>
  <main class={`pg pg-${formato}`} style={`--pg-colore:${colore};--pg-sfondo:${sfondoGal || 'transparent'}`}>
    <header class="pg-testa">
      <h1>{titolo}</h1>
      {intro.map((t) => <p>{t}</p>)}
    </header>

    <section class={`pg-gal gal ${sfondoGal ? 'su-colore' : 'su-chiaro'}`} data-click={gal.n.settings?.click} data-lb={lb} aria-label={titolo}>
      <div class="pg-griglia">
        {voci.map((i: any, k: number) => (
          <a class="gal-it pg-voce" href="#" data-i={k} data-fxd="1" data-fxm="1" aria-label={i.title || i.m?.alt || `Foto ${k + 1}`}>
            <span class="pg-foto"><img src={i.m?.src} width={i.m?.w} height={i.m?.h} alt={i.m?.alt || ''} loading={k < 4 ? 'eager' : 'lazy'} decoding="async" /></span>
            {i.nome && (
              <span class="pg-didas">
                <span class="pg-nome">{i.nome}</span>
                {i.luogo && <span class="pg-luogo">{i.luogo}</span>}
              </span>
            )}
          </a>
        ))}
      </div>
    </section>
  </main>
</Layout>

<style>
  .pg-gal { background: var(--pg-sfondo); }
  .pg-testa { background: var(--pg-colore); color: var(--chiaro); text-align: center; padding: 88px 24px 80px; }
  .pg-testa h1 { font: 800 clamp(40px, 5vw, 68px)/1.05 var(--font-avenir); letter-spacing: -1.5px; text-transform: uppercase; margin-bottom: 30px; }
  .pg-testa p { max-width: 720px; margin: 0 auto; font: 300 17px/1.75 var(--font-avenir); opacity: .92; }
  .pg-testa p + p { margin-top: 14px; }

  .pg-gal { padding: 64px 40px 96px; }
  .pg-griglia { max-width: 1400px; margin: 0 auto; display: grid; gap: 48px 32px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .pg-prodotti .pg-griglia { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px 28px; }

  /* .gal-it serve solo per aprire il lightbox: annullo le posizioni assolute della vecchia galleria (anche su mobile) */
  .pg-voce { position: relative !important; left: auto !important; top: auto !important; width: auto !important; height: auto !important; display: block; overflow: visible; cursor: zoom-in; }
  .pg-foto { display: block; overflow: hidden; aspect-ratio: 16 / 10; background: rgba(0, 0, 0, .08); }
  .pg-foto img { width: 100%; height: 100%; object-fit: cover; transition: transform .7s cubic-bezier(.22, .61, .36, 1); }
  .pg-voce:hover .pg-foto img { transform: scale(1.04); }
  .pg-prodotti .pg-foto { aspect-ratio: 1; background: #fff; }
  .pg-prodotti .pg-foto img { object-fit: contain; padding: 6%; }

  .pg-didas { display: flex; flex-direction: column; gap: 4px; margin-top: 16px; }
  .pg-nome { font: 700 17px/1.3 var(--font-avenir); letter-spacing: .01em; }
  .pg-luogo { font: 300 12px/1.4 var(--font-avenir); letter-spacing: .18em; text-transform: uppercase; opacity: .7; }
  .su-colore .pg-didas { color: var(--chiaro); }
  .su-chiaro .pg-didas { color: var(--scuro); }
  .pg-prodotti .pg-nome { font-size: 15px; text-transform: uppercase; letter-spacing: .06em; }

  @media (max-width: 1000px) { .pg-prodotti .pg-griglia { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 750px) {
    .pg-testa { padding: 14vw 6.25vw 12vw; }
    .pg-testa h1 { font-size: 10vw; letter-spacing: -.5px; margin-bottom: 6vw; }
    .pg-testa p { font-size: 4.2vw; line-height: 1.7; }
    .pg-gal { padding: 9vw 5vw 16vw; }
    .pg-griglia { grid-template-columns: 1fr; gap: 10vw; }
    .pg-prodotti .pg-griglia { grid-template-columns: 1fr 1fr; gap: 7vw 4vw; }
    .pg-didas { margin-top: 3.5vw; gap: 1vw; }
    .pg-nome { font-size: 4.4vw; }
    .pg-luogo { font-size: 3vw; }
    .pg-prodotti .pg-nome { font-size: 3.4vw; }
  }
</style>
